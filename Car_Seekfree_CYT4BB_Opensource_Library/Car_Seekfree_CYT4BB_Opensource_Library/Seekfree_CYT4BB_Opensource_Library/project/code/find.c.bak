{
    for(uint8 i=0;i<MT9V03X_H;i++)
    {

        for(uint8 j=0;j<MT9V03X_W;j++)
        {

                 // ��ֵ������
                  mt9v03x_image_BandW[i][j] = (mt9v03x_image[i][j] >= value) ? 1 : 0;
}
}
